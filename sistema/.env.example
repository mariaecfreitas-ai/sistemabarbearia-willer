# Copie este arquivo para ".env" e ajuste conforme o seu PostgreSQL

PORTA=3000

# Banco de dados PostgreSQL (mesmos dados que você usa no pgAdmin)
DB_HOST=localhost
DB_PORTA=5432
DB_USUARIO=postgres
DB_SENHA=postgres
DB_NOME=saep_db

# Segredo usado para assinar o cookie da sessão
SESSION_SECRET=troque-este-segredo

# Tempo de expiração da sessão (minutos sem uso)
SESSION_EXPIRA_MIN=30

# Chave da criptografia de CPF e telefone.
# PRECISA ser a mesma usada no saep_db.sql ('barbearia_saep_2026').
CHAVE_CRIPTO=barbearia_saep_2026
